# Groq API key — crie de graca em https://console.groq.com/keys (sem cartao)
# Copie este arquivo para .env e cole sua chave abaixo.
GROQ_API_KEY=

# Cookies para conteudo que exige login (Instagram sobretudo). Aponte para um
# cookies.txt (formato Netscape) exportado do navegador logado. Se deixar em
# branco, o tool tambem detecta automaticamente um 'cookies.txt' na propria pasta.
# Gere com a extensao "Get cookies.txt LOCALLY" (Chrome logado no instagram.com).
# VT_COOKIES_FILE=C:\caminho\para\cookies.txt

# --- Parametros do pipeline (opcional; descomente e ajuste o que quiser) ---
# Prints por minuto de video. 9999 em VT_MAX desativa o teto (sem limite).
# VT_MIN_FRAMES_PER_MINUTE=1
# VT_MAX_FRAMES_PER_MINUTE=12

# Duracao maxima aceita em horas (videos mais longos sao recusados).
# VT_MAX_DURATION_HOURS=4

# Quantos videos manter no cache local (LRU; os mais antigos sao removidos).
# VT_MAX_CACHE_ENTRIES=10

# Limiar de volume medio (dBFS) abaixo do qual o audio e tratado como silencioso
# e a transcricao e pulada (evita alucinacoes do Whisper em videos sem fala).
# VT_SILENCE_THRESHOLD_DBFS=-50

# --- Modo online / stream (perfil TELA: PC/Android) ------------------------
# Selecao de frames ao vivo. A engine AUTO-RECALIBRA o limiar de area a propria
# tela; estes governam a auto-calibracao + o piso absoluto. Racional completo em
# planning/config_parametros.md. Descomente so o que quiser mexer.
# VT_STREAM_T_COR=50           # distancia de cor p/ pixel "diferente" (subir p/ fonte ruidosa)
# VT_STREAM_WARMUP_S=2         # segundos de baseline fria antes do 1o emit
# VT_STREAM_TAU_CALIB_S=8      # constante de tempo (s) da EMA de calibracao
# VT_STREAM_AREA_K=2           # limiar de area = media + K*desvio
# VT_STREAM_AREA_FLOOR=0.02    # piso: fracao minima da tela p/ contar como mudanca (UI real pode querer 0.03-0.05)
# VT_STREAM_MIN_GAP_S=0.8      # quietude (s) que fecha um grupo de mudanca
# VT_STREAM_DEDUP_WINDOW=8     # emissoes recentes comparadas no dedup
